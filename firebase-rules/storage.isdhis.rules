// =====================================================================
//  ISDHIS ACADEMY — Cloud Storage rules
//  Every Isdhis file lives under the "Isdhis/" folder.
//
//  ⚠️  If your bucket already has rules for other apps, copy only the
//      functions and the "match /Isdhis/…" blocks into your existing
//      match /b/{bucket}/o { … } block. Do not replace everything.
//
//  These rules read Firestore (enrollments, admin sessions). The first time
//  you publish them, Firebase asks to give Storage permission to read
//  Firestore — click "Grant".
// =====================================================================

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isdhisFs(col, id) { return /databases/(default)/documents/$(col)/$(id); }
    function isdhisAdmin() {
      return request.auth != null && firestore.exists(isdhisFs('IsdhisAdminSessions', request.auth.uid));
    }
    function isdhisNotBlocked() {
      return firestore.get(isdhisFs('IsdhisUsers', request.auth.uid)).data.status != 'blocked';
    }

    // Course thumbnails: public images
    match /Isdhis/courses/{courseId}/thumbnail/{file=**} {
      allow read: if true;
      allow write: if isdhisAdmin();
    }

    // Lesson videos / PDFs / images: admin, enrolled (and not blocked) students,
    // or anyone if the lesson is marked as a free preview.
    match /Isdhis/courses/{courseId}/lessons/{lessonId}/{file=**} {
      allow read: if isdhisAdmin()
        || firestore.get(isdhisFs('IsdhisLessons', lessonId)).data.preview == true
        || (request.auth != null
            && firestore.exists(isdhisFs('IsdhisEnrollments', request.auth.uid + '_' + courseId))
            && isdhisNotBlocked());
      allow write: if isdhisAdmin();
    }

    // Payment screenshots: only the student who uploaded and the admin
    match /Isdhis/payments/{uid}/{file=**} {
      allow read: if isdhisAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isdhisAdmin();
    }

    // Logo and other site assets
    match /Isdhis/site/{file=**} {
      allow read: if true;
      allow write: if isdhisAdmin();
    }

    match /Isdhis/avatars/{uid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
